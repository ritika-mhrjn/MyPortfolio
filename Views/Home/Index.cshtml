@* ============================================================
   HERO
   ============================================================ *@
<section class="hero" id="home" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
        <div class="hero-meta">
            <p class="label hero-meta-item">(Portfolio — @DateTime.Now.Year)</p>
            <p class="label hero-meta-item hero-meta-location">Kathmandu, Nepal <span class="hero-meta-coords">27.7°N&nbsp;85.3°E</span></p>
            <p class="label hero-meta-item hero-meta-time"><span class="live-dot" aria-hidden="true"></span><span class="hero-meta-time-label">Local time</span> <span data-clock>—</span>&nbsp;NPT</p>
        </div>

        <div class="hero-title-block">
            <h1 class="hero-name" id="hero-title" aria-label="Ritika Maharjan">
                <span class="hero-name-line" aria-hidden="true">
                    @foreach (var letter in firstName)
                    {
                        <span class="char" style="--i:@(charIndex++)">@letter</span>
                    }
                </span>
                <span class="hero-name-line" aria-hidden="true">
                    @foreach (var letter in lastName)
                    {
                        <span class="char" style="--i:@(charIndex++)">@letter</span>
                    }<span class="char hero-name-dot" style="--i:@(charIndex++)">.</span>
                </span>
            </h1>
            <p class="hero-aside label" aria-hidden="true">An index of<br />backend work —<br />APIs, data &amp; systems</p>
        </div>

        <div class="hero-grid">
            <span class="hero-rule" aria-hidden="true"></span>

            <div class="hero-role">
                <p class="hero-role-title">Backend Developer</p>
                <p class="label hero-role-stack">C# / ASP.NET Core / SQL Server</p>
            </div>

            <p class="hero-intro">
                I'm a Backend Developer specializing in C# and ASP.NET Core, passionate about building reliable APIs,
                designing efficient database operations and solving real-world engineering problems.
            </p>

            <ul class="hero-actions" aria-label="Primary links">
                <li><a class="arrow-link" href="/#projects"><span class="arrow-link-icon arrow-down" aria-hidden="true">↓</span><span class="arrow-link-text">View Selected Work</span></a></li>
                <li><a class="arrow-link" href="/#contact"><span class="arrow-link-icon" aria-hidden="true">→</span><span class="arrow-link-text">Get in Touch</span></a></li>
                <li><a class="arrow-link" href="/files/RitikaCVOnline.pdf" download="Ritika-Maharjan-CV.pdf"><span class="arrow-link-icon arrow-down" aria-hidden="true">⤓</span><span class="arrow-link-text">Download CV</span><span class="label">PDF</span></a></li>
                <li class="hero-socials">
                    <a class="text-link" href="https://github.com/ritika-mhrjn" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
                    <a class="text-link" href="https://www.linkedin.com/in/ritikamhrz/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
                </li>
            </ul>
        </div>

        <div class="hero-foot">
            <p class="hero-currently">
                <span class="label">Currently</span>
                <span class="hero-currently-text">Jr. Developer at Global Square — <span class="rotator" data-rotator data-words='["building REST APIs","writing stored procedures","tracing bugs to the data","streaming updates with SSE"]'>building REST APIs</span></span>
            </p>
            <a class="scroll-cue label" href="/#about"><span>Scroll</span><span class="scroll-cue-line" aria-hidden="true"></span></a>
        </div>
    </div>
</section>

@* ============================================================
   01 — ABOUT
   ============================================================ *@
<section class="section about" id="about" aria-labelledby="about-title">
    <div class="wrap">
        <header class="section-head">
            <span class="section-index">(01)</span>
            <h2 class="label section-label" id="about-title">About</h2>
            <span class="rule" aria-hidden="true"></span>
            <span class="label section-aside">Profile</span>
        </header>

        <div class="about-grid">
            <p class="about-statement reveal-title">
                I build the parts of software people rarely see — <span class="accent">the APIs, queries and business logic</span>
                that keep real applications <em class="serif">dependable.</em>
            </p>

            <div class="about-columns">
                <div class="about-column reveal" style="--d:0ms">
                    <h3 class="label">The journey</h3>
                    <p>
                        I joined Global Square in September 2025 as a Backend Developer Intern, contributing to the Tapaiko Bazar
                        e-commerce platform. As a trainee I worked on a Human Resource Management System built around clean
                        architecture, and today, as a Jr. Developer, I develop and maintain customer and administrative modules for Hoslog.
                    </p>
                </div>
                <div class="about-column reveal" style="--d:120ms">
                    <h3 class="label">The approach</h3>
                    <p>
                        I like tracing a problem from the request all the way to the data — reading the stored procedure, checking
                        the query, understanding why. I work within an application's existing architecture and coding standards,
                        and favour clear, maintainable solutions.
                    </p>
                </div>
                <div class="about-column reveal" style="--d:240ms">
                    <h3 class="label">The interests</h3>
                    <p>
                        REST API design, efficient database operations with Dapper and SQL Server, authentication and validation,
                        and real-time updates with Server-Sent Events that replace repeated polling.
                    </p>
                </div>
            </div>

            <dl class="facts reveal">
                <div class="fact"><dt class="label">Based in</dt><dd>Kathmandu, Nepal</dd></div>
                <div class="fact"><dt class="label">Working at</dt><dd>Global Square, since 2025</dd></div>
                <div class="fact"><dt class="label">Focus</dt><dd>APIs &amp; data access</dd></div>
                <div class="fact"><dt class="label">Core stack</dt><dd>C# · ASP.NET Core · SQL Server</dd></div>
            </dl>
        </div>
    </div>
</section>

